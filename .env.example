# === App LLM config (canonical) ===
# provider: claude | openai | deepseek | opencode-go
LLM_PROVIDER=opencode-go

# API key for the active provider (preferred over provider-specific keys)
LLM_API_KEY=sk-your-key-here

# Role models (analysis = 分析提取; write = 续写/agent)
LLM_ANALYSIS_MODEL=deepseek-v4-flash
LLM_WRITE_MODEL=deepseek-v4-pro
# Optional single fallback model id
# LLM_MODEL=deepseek-v4-flash

# Optional OpenAI-compatible base URL (defaults per provider)
# OpenCode Go: https://opencode.ai/zen/go/v1
# DeepSeek direct: https://api.deepseek.com/v1
# LLM_BASE_URL=https://opencode.ai/zen/go/v1

LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# --- Legacy / provider-specific (optional; only if not using LLM_API_KEY) ---
# OPENCODE_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o

# Admin users: comma-separated emails get isAdmin (see /admin, unlimited upload/rate limits)
# ADMIN_EMAILS=you@example.com,other@example.com
#
# Legacy shared admin password (optional; prefer ADMIN_EMAILS + login)
# ADMIN_PASSWORD=

# --- Character mention scan (runtime: /admin 「运行配置」 or GET/PATCH /api/admin/settings) ---
# Normal: concurrency=4, batch units=4. Admin/debug: concurrency=20 (not uncapped); admin batch units=1.
# CHARACTER_MENTION_CONCURRENCY=4
# CHARACTER_MENTION_BATCH_UNITS=4
# CHARACTER_MENTION_BATCH_CHARS=16000
# CHARACTER_MENTION_PRIVILEGED_CONCURRENCY=20
# CHARACTER_MENTION_ADMIN_BATCH_UNITS=1
# Overrides also in data/runtime-settings.json (admin UI/API).

# --- Character coref (window / residual; design §10)
# CHARACTER_COREF_WINDOW_CHARS=6000
# CHARACTER_COREF_OVERLAP_CHARS=800
# CHARACTER_COREF_AUTO_MERGE_THRESHOLD=0.85
# CHARACTER_COREF_GREY_LOW_THRESHOLD=0.45
# CHARACTER_COREF_WEIGHT_EXCLUSIVE=0.5
# CHARACTER_COREF_WEIGHT_JACCARD=0.3
# CHARACTER_COREF_JACCARD_SPARSE_MIN_COUNT=3
# CHARACTER_COREF_JACCARD_SPARSE_DISCOUNT=0.5
# CHARACTER_COREF_TEMPORAL_HIGH_OVERLAP=0.8
# CHARACTER_COREF_TEMPORAL_MID_OVERLAP=0.2
# CHARACTER_COREF_TEMPORAL_PENALTY_HIGH=0
# CHARACTER_COREF_TEMPORAL_PENALTY_MID=-0.05
# CHARACTER_COREF_TEMPORAL_PENALTY_LOW=-0.2
# CHARACTER_COREF_CHUNK_GAP_MAX=10
# CHARACTER_COREF_ALIAS_HARD_MERGE_MIN=2
# CHARACTER_COREF_ALIAS_BUCKET_MAX=12
# CHARACTER_COREF_GREY_CONTEXT_CHARS=200
# CHARACTER_COREF_HARD_REJECT_SAME_UNIT=true
# CHARACTER_COREF_HARD_REJECT_GENDER=true
# CHARACTER_COREF_HARD_REJECT_AGE=true
# CHARACTER_COREF_HARD_MERGE_SAME_NAME=true

# --- Database ---
# App default: data/novels.db
# Eval scripts call useEvalDb() → data/eval/novels.db (isolated; do not point this at main for npm run eval:*)
# NCS_DB_PATH=data/novels.db
# NOVEL_DB_PATH=  # alias of NCS_DB_PATH
